# Copy to .env and fill in your own API credentials.
NAME=ondo_grid
ONDO_API_KEY_ID=
ONDO_API_SECRET=
ONDO_API_URL=https://api.ondoperps.xyz
ONDO_TIMEOUT=10

# Example parameters only: adjust to your market and account before starting.
# SYMBOL also accepts the native ID ETH-USD.P or ETH/USDT:USDT.
SYMBOL=ETH
gridLines=60
gridStep=1
orderSize=0.01
lowLimit=1000
highLimit=3000
baseline=2000
left=0
maxposi=1
MAX_LOSS=-100

CHECK_INTERVAL=0.8
CANCEL_ON_EXIT=true
CANCEL_ON_RISK=true
CRITICAL_ERROR_LIMIT=3
LOG_LEVEL=INFO
NOTIFY_WEBHOOK=
