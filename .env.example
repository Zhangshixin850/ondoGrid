# Ondo v3.0 / Ubuntu Python 3.10+
NAME=ondo_grid
ONDO_API_KEY_ID=
ONDO_API_SECRET=
ONDO_API_URL=https://api.ondoperps.xyz
ONDO_TIMEOUT=30

# Shared settings; account and position risk refreshed every 20 loops.
CHECK_INTERVAL=0.8
MMR=0.2
leverage=5
CANCEL_ON_EXIT=true
CANCEL_ON_RISK=true
CRITICAL_ERROR_LIMIT=3
LOG_LEVEL=INFO
NOTIFY_WEBHOOK=

# Grid 1: examples only; configure for your own market/account.
SYMBOL1=ETH
gridLines1=60
gridStep1=0.5
orderSize1=0.05
lowLimit1=2000
highLimit1=2600
baseline1=2300
left1=0
maxposi1=40
MAX_LOSS1=-8000

# Grid 2: blank SYMBOL disables the group. Fill ALL parameters to enable.
SYMBOL2=
gridLines2=
gridStep2=
orderSize2=
lowLimit2=
highLimit2=
baseline2=
left2=
maxposi2=
MAX_LOSS2=

# Grid 3: blank SYMBOL disables the group.
SYMBOL3=
gridLines3=
gridStep3=
orderSize3=
lowLimit3=
highLimit3=
baseline3=
left3=
maxposi3=
MAX_LOSS3=

